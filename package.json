{
  "name": "axioma",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run build && npm test && npm run test:e2e && npm run test:rules",
    "test:rules": "firebase emulators:exec --only firestore --project demo-axioma \"node --test tests/firestore.rules.mjs\"",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "firebase": "^13.0.0",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.51.0",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^15.33.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
